{
  "version": 2,
  "doc": "Closed catalog of avatar expressions. Single source of truth: the core reducer, the LLM prompt, the TS types (kali-web/src/avatar/avatarCatalog.gen.ts, generated by scripts/gen-avatar-catalog.mjs) and the rig read this file. Deltas are additive over `neutral`; channel units are in `channels`.",
  "channels": {
    "eyeOpenL": { "min": 0, "max": 1.2, "neutral": 1, "doc": "left eyelid opening, 0 closed" },
    "eyeOpenR": { "min": 0, "max": 1.2, "neutral": 1, "doc": "right eyelid opening" },
    "lowerLid": { "min": 0, "max": 1, "neutral": 0, "doc": "lower lid raise (smiling eyes)" },
    "lidSlant": { "min": -1, "max": 1, "neutral": 0, "doc": "+ angry (inner side down), - sad (inner side up)" },
    "pupilScale": { "min": 0.3, "max": 1.4, "neutral": 1, "doc": "pupil size" },
    "pupilSlit": { "min": 0, "max": 1, "neutral": 0, "doc": "vertical slit (cat only)" },
    "browY": { "min": -1, "max": 1, "neutral": 0, "doc": "+ raised" },
    "browAngle": { "min": -1, "max": 1, "neutral": 0, "doc": "+ angry, - worried" },
    "browAsym": { "min": -1, "max": 1, "neutral": 0, "doc": "+ left brow up / right down" },
    "blush": { "min": 0, "max": 1, "neutral": 0, "doc": "cheek colour" },
    "earTilt": { "min": -1, "max": 1, "neutral": 0, "doc": "+ perked, - flattened / drooping" },
    "earAsym": { "min": -1, "max": 1, "neutral": 0, "doc": "+ left ear up / right down" },
    "headTilt": { "min": -20, "max": 20, "neutral": 0, "doc": "degrees" },
    "headY": { "min": -12, "max": 12, "neutral": 0, "doc": "px, + down" },
    "bodyY": { "min": -24, "max": 12, "neutral": 0, "doc": "px, - up" },
    "mouthOpen": { "min": 0, "max": 1, "neutral": 0, "doc": "mouth aperture (speech, yawn)" },
    "gazeX": { "min": -1, "max": 1, "neutral": 0, "doc": "additive gaze offset" },
    "gazeY": { "min": -1, "max": 1, "neutral": 0, "doc": "additive gaze offset" },
    "halo": { "min": 0, "max": 0.6, "neutral": 0.12, "doc": "presence halo opacity" },
    "whisker": { "min": 0, "max": 1, "neutral": 0.5, "doc": "whisker sway amplitude (cat)" },
    "breath": { "min": 0, "max": 2.5, "neutral": 1, "doc": "breathing amplitude and rate multiplier" }
  },
  "mouthShapes": ["neutral", "smile", "frown", "o", "flat", "catw", "angry"],
  "symbols": ["none", "question", "exclaim", "heart", "zz", "sweat", "tear", "sparkle", "dots"],
  "haloTones": ["accent", "think", "wait", "work", "sleep", "alert"],
  "attentions": ["cursor", "input", "thought", "work", "user", "none"],
  "sources": ["pet", "user", "llm", "system", "heuristic"],

  "engine": {
    "listenMs": 8000,
    "thinkWatchdogMs": 90000,
    "toolWatchdogMs": 20000,
    "typingMs": 4000,
    "relaxedMs": 300000,
    "sleepMs": 900000,
    "emotionCooldownMs": 1200,
    "emotionFadeMs": 1500,
    "emotionResumeMs": 1500,
    "speechTailMs": 300,
    "unknownSpeechMs": 1500,
    "gestureStaleMs": 1000,
    "gestureQueue": 2,
    "envHz": 20,
    "petMinIntervalMs": 2000,
    "heuristicMaxIntensity": 0.4,
    "defaultLlmIntensity": 0.7
  },

  "perf": {
    "quality": { "fps": 60, "breath": true, "halo": "animated", "whiskers": true, "micro": true, "gestures": "all", "shadow": true },
    "balanced": { "fps": 30, "breath": true, "halo": "static", "whiskers": true, "micro": true, "gestures": "all", "shadow": false },
    "performance": { "fps": 20, "breath": false, "halo": "none", "whiskers": false, "micro": false, "gestures": "semantic", "shadow": false }
  },

  "activities": {
    "offline": { "priority": 100, "minMs": 0, "attention": "none", "emotionMult": 0, "tone": "sleep", "mouth": "flat", "symbol": "none",
      "delta": { "eyeOpenL": -0.4, "eyeOpenR": -0.4, "halo": -0.1, "breath": -0.7 } },
    "esperando": { "priority": 90, "minMs": 400, "attention": "user", "emotionMult": 0.5, "tone": "wait", "symbol": "question",
      "delta": { "browY": 0.5, "earTilt": 0.4, "headTilt": 4, "pupilScale": 0.1, "halo": 0.1 } },
    "escuchando": { "priority": 80, "minMs": 0, "attention": "user", "emotionMult": 0.5, "tone": "accent",
      "delta": { "earTilt": 0.5, "pupilScale": 0.1, "browY": 0.2, "halo": 0.1 } },
    "hablando": { "priority": 70, "minMs": 300, "attention": "user", "emotionMult": 1, "tone": "accent",
      "delta": { "halo": 0.1 } },
    "trabajando": { "priority": 60, "minMs": 600, "attention": "work", "emotionMult": 0.3, "tone": "work",
      "delta": { "eyeOpenL": -0.2, "eyeOpenR": -0.2, "browY": -0.1, "browAngle": 0.15, "earTilt": -0.2, "pupilScale": -0.1, "halo": 0.05 } },
    "pensando": { "priority": 50, "minMs": 400, "attention": "thought", "emotionMult": 0.4, "tone": "think", "symbol": "dots",
      "delta": { "eyeOpenL": -0.25, "eyeOpenR": -0.25, "browY": 0.1, "headTilt": 3 } },
    "atento": { "priority": 40, "minMs": 0, "attention": "input", "emotionMult": 0.8, "tone": "accent",
      "delta": { "earTilt": 0.4, "headTilt": 2, "pupilScale": 0.1 } },
    "reposo": { "priority": 10, "minMs": 0, "attention": "cursor", "emotionMult": 1, "tone": "accent", "delta": {} },
    "relajado": { "priority": 8, "minMs": 0, "attention": "cursor", "emotionMult": 1, "tone": "accent",
      "delta": { "eyeOpenL": -0.2, "eyeOpenR": -0.2, "breath": -0.3, "earTilt": -0.1 } },
    "durmiendo": { "priority": 5, "minMs": 0, "attention": "none", "emotionMult": 0, "tone": "sleep", "symbol": "zz", "mouth": "neutral",
      "delta": { "eyeOpenL": -1, "eyeOpenR": -1, "breath": -0.4, "earTilt": -0.3, "headY": 3, "halo": -0.07 } }
  },

  "emotions": {
    "neutral": { "label": "neutral", "decayMs": 0, "mouth": "neutral", "symbol": "none", "delta": {},
      "description": "Estado neutro, sin emoción particular" },
    "alegre": { "label": "alegre", "decayMs": 8000, "mouth": "smile", "symbol": "none",
      "delta": { "eyeOpenL": -0.2, "eyeOpenR": -0.2, "lowerLid": 0.5, "pupilScale": 0.05, "browY": 0.4, "blush": 0.5, "earTilt": 0.3, "bodyY": -2, "halo": 0.1, "whisker": 0.2 },
      "description": "Alegría, satisfacción, algo salió bien" },
    "carinoso": { "label": "cariñoso", "decayMs": 4000, "mouth": "catw", "symbol": "heart",
      "delta": { "eyeOpenL": -1.0, "eyeOpenR": -1.0, "lowerLid": 0.6, "browY": 0.2, "browAngle": -0.2, "blush": 0.8, "earTilt": 0.2, "headTilt": 4, "halo": 0.1 },
      "description": "Cariño, ternura, contento al ser acariciado" },
    "sorprendido": { "label": "sorprendido", "decayMs": 2500, "mouth": "o", "symbol": "exclaim",
      "delta": { "eyeOpenL": 0.15, "eyeOpenR": 0.15, "pupilScale": -0.55, "browY": 1, "earTilt": 0.6, "headY": -4, "halo": 0.1 },
      "description": "Sorpresa, asombro, resultado inesperado" },
    "curioso": { "label": "curioso", "decayMs": 6000, "mouth": "neutral", "symbol": "none",
      "delta": { "eyeOpenL": 0.05, "eyeOpenR": 0.05, "pupilScale": 0.15, "browAsym": 0.6, "browY": 0.2, "earAsym": 0.6, "headTilt": 6 },
      "description": "Curiosidad, interés por algo nuevo" },
    "confundido": { "label": "confundido", "decayMs": 6000, "mouth": "flat", "symbol": "question",
      "delta": { "eyeOpenL": -0.2, "eyeOpenR": -0.45, "browAsym": -0.6, "earTilt": -0.2, "earAsym": -0.5, "headTilt": 8 },
      "description": "Duda, confusión, algo salió raro" },
    "preocupado": { "label": "preocupado", "decayMs": 8000, "mouth": "flat", "symbol": "sweat",
      "delta": { "eyeOpenL": -0.15, "eyeOpenR": -0.15, "pupilScale": 0.1, "browY": 0.5, "browAngle": -0.5, "lidSlant": -0.4, "earTilt": -0.4, "headY": 2 },
      "description": "Preocupación, empatía ante un problema del usuario o un fallo" },
    "triste": { "label": "triste", "decayMs": 15000, "mouth": "frown", "symbol": "tear",
      "delta": { "eyeOpenL": -0.4, "eyeOpenR": -0.4, "pupilScale": 0.2, "browY": 0.3, "browAngle": -0.8, "lidSlant": -0.7, "earTilt": -0.8, "headY": 6, "headTilt": -3, "breath": -0.4, "halo": -0.05 },
      "description": "Tristeza, dolor, decepción" },
    "molesto": { "label": "molesto", "decayMs": 6000, "mouth": "angry", "symbol": "none",
      "delta": { "eyeOpenL": -0.35, "eyeOpenR": -0.35, "pupilScale": -0.4, "pupilSlit": 0.85, "browY": -0.3, "browAngle": 0.9, "lidSlant": 0.8, "earTilt": -1, "whisker": 0.4 },
      "description": "Molestia, frustración, enfado (solo si encaja con lo que dices)" },
    "orgulloso": { "label": "orgulloso", "decayMs": 8000, "mouth": "smile", "symbol": "sparkle",
      "delta": { "eyeOpenL": -0.3, "eyeOpenR": -0.3, "lowerLid": 0.2, "browY": 0.2, "headY": -4, "bodyY": -3, "earTilt": 0.4, "blush": 0.2 },
      "description": "Orgullo por un logro propio o del usuario" },
    "avergonzado": { "label": "avergonzado", "decayMs": 6000, "mouth": "flat", "symbol": "sweat",
      "delta": { "eyeOpenL": -0.25, "eyeOpenR": -0.25, "pupilScale": 0.1, "browY": 0.3, "browAngle": -0.4, "blush": 1, "headY": 5, "headTilt": -5, "earTilt": -0.5 },
      "description": "Vergüenza, disculpa, error propio" },
    "emocionado": { "label": "emocionado", "decayMs": 6000, "mouth": "smile", "symbol": "sparkle",
      "delta": { "eyeOpenL": 0.15, "eyeOpenR": 0.15, "pupilScale": 0.2, "browY": 0.7, "blush": 0.4, "earTilt": 0.7, "breath": 1, "halo": 0.2 },
      "description": "Emoción, entusiasmo, ganas de empezar" },
    "pensativo": { "label": "pensativo", "decayMs": 10000, "mouth": "flat", "symbol": "dots",
      "delta": { "eyeOpenL": -0.2, "eyeOpenR": -0.2, "browAsym": 0.4, "browY": 0.1, "headTilt": 4, "headY": 1, "earTilt": -0.1 },
      "description": "Reflexión, sopesando algo con calma" },
    "somnoliento": { "label": "somnoliento", "decayMs": 20000, "mouth": "flat", "symbol": "zz",
      "delta": { "eyeOpenL": -0.55, "eyeOpenR": -0.55, "pupilScale": -0.1, "browY": -0.1, "earTilt": -0.5, "headY": 4, "breath": -0.3 },
      "description": "Cansancio, sueño" },
    "travieso": { "label": "travieso", "decayMs": 5000, "mouth": "catw", "symbol": "none",
      "delta": { "eyeOpenL": -0.15, "eyeOpenR": -0.55, "lidSlant": 0.3, "browAsym": 0.5, "browAngle": 0.3, "earAsym": 0.4, "blush": 0.2, "headTilt": -5 },
      "description": "Picardía, broma, tono juguetón" },
    "aburrido": { "label": "aburrido", "decayMs": 10000, "mouth": "flat", "symbol": "none",
      "delta": { "eyeOpenL": -0.45, "eyeOpenR": -0.45, "pupilScale": -0.1, "browY": -0.2, "earTilt": -0.4, "headY": 4, "headTilt": -4, "breath": -0.2 },
      "description": "Aburrimiento, desinterés, algo repetitivo" },
    "determinado": { "label": "determinado", "decayMs": 8000, "mouth": "flat", "symbol": "none",
      "delta": { "eyeOpenL": -0.2, "eyeOpenR": -0.2, "pupilScale": -0.1, "browY": -0.1, "browAngle": 0.4, "earTilt": 0.3, "headY": -2 },
      "description": "Determinación, decisión de resolver algo difícil" },
    "asustado": { "label": "asustado", "decayMs": 4000, "mouth": "o", "symbol": "sweat",
      "delta": { "eyeOpenL": 0.2, "eyeOpenR": 0.2, "pupilScale": -0.6, "browY": 0.9, "browAngle": -0.6, "earTilt": -0.9, "headY": 4, "breath": 0.8 },
      "description": "Susto, miedo, peligro" }
  },

  "gestures": {
    "asentir": { "durMs": 600, "priority": 3, "origin": "core", "semantic": true,
      "tracks": [{ "ch": "headY", "keys": [[0, 0], [0.25, 7], [0.5, 0], [0.75, 5], [1, 0]] }] },
    "negar": { "durMs": 700, "priority": 3, "origin": "core", "semantic": true,
      "tracks": [{ "ch": "headTilt", "keys": [[0, 0], [0.2, -8], [0.45, 8], [0.7, -6], [1, 0]] }] },
    "orejas_atras": { "durMs": 900, "priority": 4, "origin": "core", "semantic": true,
      "tracks": [{ "ch": "earTilt", "keys": [[0, 0], [0.2, -1], [0.7, -1], [1, 0]] }] },
    "sobresalto": { "durMs": 500, "priority": 5, "origin": "core", "semantic": true,
      "tracks": [
        { "ch": "bodyY", "keys": [[0, 0], [0.15, -8], [0.5, -2], [1, 0]] },
        { "ch": "eyeOpenL", "keys": [[0, 0], [0.15, 0.25], [1, 0]] },
        { "ch": "eyeOpenR", "keys": [[0, 0], [0.15, 0.25], [1, 0]] },
        { "ch": "earTilt", "keys": [[0, 0], [0.2, 0.6], [1, 0]] }] },
    "celebrar": { "durMs": 800, "priority": 3, "origin": "core", "semantic": true,
      "tracks": [
        { "ch": "bodyY", "keys": [[0, 0], [0.25, -12], [0.5, 0], [0.7, -6], [1, 0]] },
        { "ch": "earTilt", "keys": [[0, 0], [0.3, 0.6], [1, 0]] }] },
    "ronroneo": { "durMs": 2500, "priority": 6, "origin": "core", "semantic": true,
      "tracks": [
        { "ch": "bodyY", "osc": { "amp": 1, "hz": 2 } },
        { "ch": "eyeOpenL", "keys": [[0, 0], [0.15, -0.8], [0.85, -0.8], [1, 0]] },
        { "ch": "eyeOpenR", "keys": [[0, 0], [0.15, -0.8], [0.85, -0.8], [1, 0]] }] },
    "guino": { "durMs": 350, "priority": 2, "origin": "core", "semantic": false,
      "tracks": [{ "ch": "eyeOpenL", "keys": [[0, 0], [0.3, -1], [0.7, -1], [1, 0]] }] },
    "bostezo": { "durMs": 1600, "priority": 1, "origin": "view", "semantic": false,
      "tracks": [
        { "ch": "mouthOpen", "keys": [[0, 0], [0.3, 1], [0.7, 1], [1, 0]] },
        { "ch": "eyeOpenL", "keys": [[0, 0], [0.3, -0.8], [0.7, -0.8], [1, 0]] },
        { "ch": "eyeOpenR", "keys": [[0, 0], [0.3, -0.8], [0.7, -0.8], [1, 0]] },
        { "ch": "headY", "keys": [[0, 0], [0.35, -4], [0.7, -4], [1, 0]] }] },
    "despertar": { "durMs": 900, "priority": 5, "origin": "core", "semantic": true,
      "tracks": [
        { "ch": "eyeOpenL", "keys": [[0, -0.6], [0.4, 0.1], [1, 0]] },
        { "ch": "eyeOpenR", "keys": [[0, -0.6], [0.4, 0.1], [1, 0]] },
        { "ch": "bodyY", "keys": [[0, 0], [0.3, -5], [1, 0]] },
        { "ch": "earTilt", "keys": [[0, 0], [0.3, 0.5], [1, 0]] }] },
    "mirar_alrededor": { "durMs": 2000, "priority": 1, "origin": "view", "semantic": false,
      "tracks": [{ "ch": "gazeX", "keys": [[0, 0], [0.2, -0.7], [0.5, -0.7], [0.7, 0.7], [0.9, 0], [1, 0]] }] },
    "sacudir_oreja": { "durMs": 400, "priority": 1, "origin": "view", "semantic": false,
      "tracks": [{ "ch": "earAsym", "keys": [[0, 0], [0.3, 0.8], [0.6, -0.4], [1, 0]] }] },
    "ladear": { "durMs": 1200, "priority": 1, "origin": "view", "semantic": false,
      "tracks": [{ "ch": "headTilt", "keys": [[0, 0], [0.3, 8], [0.8, 8], [1, 0]] }] },
    "saludar": { "durMs": 1000, "priority": 3, "origin": "core", "semantic": false,
      "tracks": [
        { "ch": "earTilt", "keys": [[0, 0], [0.3, 0.6], [1, 0]] },
        { "ch": "headY", "keys": [[0, 0], [0.3, -4], [1, 0]] },
        { "ch": "blush", "keys": [[0, 0], [0.4, 0.4], [1, 0]] }] },
    "pestanear_lento": { "durMs": 900, "priority": 2, "origin": "view", "semantic": false,
      "tracks": [
        { "ch": "eyeOpenL", "keys": [[0, 0], [0.35, -1], [0.55, -1], [1, 0]] },
        { "ch": "eyeOpenR", "keys": [[0, 0], [0.35, -1], [0.55, -1], [1, 0]] },
        { "ch": "blush", "keys": [[0, 0], [0.4, 0.3], [1, 0]] }] }
  },

  "emotionAliases": {
    "normal": "neutral", "feliz": "alegre", "enojado": "molesto", "ronroneando": "carinoso", "concentrado": "pensativo",
    "esperando": "neutral", "cariñoso": "carinoso", "happy": "alegre", "sad": "triste", "angry": "molesto",
    "surprised": "sorprendido", "confused": "confundido", "curious": "curioso", "worried": "preocupado",
    "proud": "orgulloso", "excited": "emocionado", "sleepy": "somnoliento", "scared": "asustado", "playful": "travieso"
  },

  "idleGestures": ["mirar_alrededor", "sacudir_oreja", "ladear"],

  "prompt": {
    "intro": "Opcional: puedes empezar tu respuesta con [EMOTION: id] o [EMOTION: id 0.0-1.0] (intensidad) para que tu avatar refleje cómo te sientes. Si tu ánimo cambia, pon otra etiqueta justo al inicio de la frase donde cambia (nunca a mitad de una frase); la voz y la cara se sincronizan por bloques, así que no abuses: como mucho una por párrafo. No la menciones ni la expliques. Usa solo estos ids:",
    "examples": ["[EMOTION: alegre 0.8] ¡Listo! Ya está creado el archivo.", "[EMOTION: confundido] Mmm, no estoy seguro de haber entendido.",
    "[EMOTION: alegre 0.8] ¡Funcionó! [EMOTION: preocupado 0.5] Eso sí, falló un test que no es mío."]
  }
}
